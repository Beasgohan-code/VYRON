# ═══════════════════════════════════════════════════════════════════════════
#  VYRON — environment
#  Copy to .env and fill in. Everything else has a sensible default.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=

# From https://my.telegram.org → API development tools
API_ID=
API_HASH=

# Assistant account (userbot) that joins the voice chat.
# Generate with:  python -m vyron.tools.session
STRING_SESSION=

# Your Telegram user id — from @userinfobot
OWNER_ID=

# ─── Identity ──────────────────────────────────────────────────────────────
BOT_USERNAME=VyronMusicBot
BOT_NAME=VYRON
SUDO_USERS=
SUPPORT_CHAT=https://t.me/BeasgohanSupport
UPDATES_CHANNEL=https://t.me/BeasgohanSupport

# ─── Storage (optional — JSON file is used when empty) ─────────────────────
MONGO_URL=
MONGO_DB=vyron
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# ─── Playback ──────────────────────────────────────────────────────────────
AUDIO_QUALITY=high          # low | medium | high
VIDEO_QUALITY=720p          # 360p | 480p | 720p | 1080p
DEFAULT_VOLUME=100          # 1-200
MAX_QUEUE_SIZE=100
MAX_TRACK_MINUTES=0         # 0 = unlimited
IDLE_LEAVE_SECONDS=300      # leave an empty VC after this long (0 = never)
AUTOPLAY=true               # play related tracks when the queue ends
ALWAYS_ON=false             # 24/7 by default in new chats
STREAM_CACHE_TTL=1800
DOWNLOAD_CACHE_HOURS=24
MAX_DOWNLOAD_MB=200

# ─── yt-dlp ────────────────────────────────────────────────────────────────
COOKIES_FILE=               # netscape cookies.txt for age-restricted videos
PROXY=                      # http://host:port or socks5://…
YTDLP_ARGS=
SEARCH_RESULTS=5

# ─── UI: premium emoji & new Bot API features ──────────────────────────────
PREMIUM_EMOJI=true
PREMIUM_EMOJI_FILE=         # defaults to ./emoji.json
RICH_MESSAGES=true          # rich cards (headings, tables, tg-buttons)
EPHEMERAL_CARDS=true        # private cards inside groups
NP_REFRESH_SECONDS=12

# ─── Runtime ───────────────────────────────────────────────────────────────
PORT=8080                   # health server (Render/Koyeb need this)
LOG_LEVEL=INFO
SESSION_NAME=vyron
