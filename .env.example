# ═══════════════════════════════════════════════════════════════════════════
#  VYRON — environment
#  Copy to .env and fill in. Everything else has a sensible default.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=

# From https://my.telegram.org → API development tools
API_ID=
API_HASH=

# Assistant account (userbot) that joins the voice chat — REQUIRED.
# VYRON streams through this account; the bot refuses to start without a valid
# session. Generate one with:  python -m vyron.tools.session
STRING_SESSION=

# Your Telegram user id — from @userinfobot (optional, but you lose owner access).
# OWNER_ID (and SUDO_USERS) can run /apitoken: a signed token that opens the
# Mini App from any browser and grants every scope on the /v1 music API.
OWNER_ID=

# ─── Identity ──────────────────────────────────────────────────────────────
BOT_USERNAME=VyronMusicBot
BOT_NAME=𓆩 𝐕𝐘𝐑𝐎𝐍 𓆪   # the display name Telegram shows; escape-free UTF-8 is fine
SUDO_USERS=
SUPPORT_CHAT=https://t.me/BeasgohanSupport
UPDATES_CHANNEL=https://t.me/BeasgohanSupport

# ─── Group management ──────────────────────────────────────────────────────
LOGGER_ID=                 # channel/group where moderation actions are logged
WARN_LIMIT=3               # default warns before an automatic ban
FLOOD_LIMIT=7              # messages per FLOOD_WINDOW before a mute
FLOOD_WINDOW=9
WELCOME_TEXT=              # default welcome, supports {mention} {first} {chat} {id} {count}

# ─── Storage (optional — JSON file is used when empty) ─────────────────────
MONGO_URL=
MONGO_DB=vyron
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# ─── Playback ──────────────────────────────────────────────────────────────
AUDIO_QUALITY=high          # low | medium | high
VIDEO_QUALITY=720p          # 360p | 480p | 720p | 1080p
DEFAULT_VOLUME=100          # 1-200
MAX_QUEUE_SIZE=100
MAX_TRACK_MINUTES=0         # 0 = unlimited
IDLE_LEAVE_SECONDS=300      # leave an empty VC after this long (0 = never)
AUTOPLAY=true               # play related tracks when the queue ends
ALWAYS_ON=false             # 24/7 by default in new chats
STREAM_CACHE_TTL=1800
# Keep-alive: ping our own public URL so free hosts don't sleep the service.
# RENDER_EXTERNAL_URL is set by Render automatically; set KEEPALIVE_URL on
# Koyeb/Railway. 0 disables the loop.
KEEPALIVE_MINUTES=10
KEEPALIVE_URL=

# Connection watchdog: reconnect the bot/assistant if the socket drops (0 = off)
WATCHDOG_SECONDS=60

# Housekeeping loop: prune downloads + old history rows every N hours
# (0 disables the loop — the /clearcache and /dbcleanup commands still work)
MAINTENANCE_HOURS=
MAINTENANCE_DAYS=
DOWNLOAD_CACHE_HOURS=24
MAX_DOWNLOAD_MB=200

# ─── yt-dlp ────────────────────────────────────────────────────────────────
COOKIES_FILE=               # netscape cookies.txt for age-restricted videos
YOUTUBE_COOKIES=            # …or paste that file's text here (hosts without uploads)
PROXY=                      # http://host:port or socks5://…
YTDLP_ARGS=
# When every yt-dlp client fails, ask Invidious/Piped for a direct URL.
STREAM_FALLBACK=on
#STREAM_FALLBACK_HOSTS=inv.nadeko.net,invidious.nerdvpn.de
STREAM_FALLBACK_TIMEOUT=9
# A track that just failed is not retried for this long (seconds).
STREAM_FAILURE_TTL=60
# yt-dlp is CPU-bound: cap how many extractions run at once.
EXTRACT_CONCURRENCY=2

# ─── Playback strategy ─────────────────────────────────────────────────────
# Download first, stream the local file (the ShizuMusic model). Reliable on
# datacenter IPs where a remote stream URL can 403 mid-song; the cache makes
# repeats instant. Set off to stream URLs directly.
PLAY_FROM_DISK=on

# ─── Download API (/vyron) ─────────────────────────────────────────────────
VYRON_API=on               # off = unmount /vyron
YOUTUBE_PROXY_FILE=        # optional file with one proxy per line
YT_DLP_FORMAT=bestaudio/best
YT_DLP_SOCKET_TIMEOUT=20
YT_DLP_RETRIES=3
DOWNLOAD_CLEANUP_SECONDS=900
YOUTUBE_PROXY=              # falls back to PROXY
YOUTUBE_COOKIES_FILE=       # falls back to COOKIES_FILE
SEARCH_RESULTS=5

# ─── UI: premium emoji & new Bot API features ──────────────────────────────
PREMIUM_EMOJI=true
PREMIUM_EMOJI_FILE=         # defaults to ./emoji.json
RICH_MESSAGES=true          # rich cards; false = the classic (old) HTML UI
BOT_PROFILE=true            # on boot: bot name/bio + scoped command menus
EPHEMERAL_CARDS=true        # private cards inside groups
NP_REFRESH_SECONDS=12
NP_POSTER=true              # render a poster per track (cover, vinyl, waveform)
NP_DM=true                  # mirror Mini App playback into the listener's DM

# ─── Web app (Telegram Mini App) ───────────────────────────────────────────
WEBAPP=true
WEBAPP_URL=                # public URL of this deployment, e.g. https://vyron.onrender.com
WEBAPP_TITLE=VYRON Player
WEBAPP_ALLOW_ANON=false    # dev only: let browsers without Telegram auth read state

# ─── Music API (/v1 — one process, one URL, no extra service) ─────────────
MUSIC_API=true             # serve /v1 on this deployment
MUSIC_API_OPEN=false       # dev only: allow requests without an API key
MUSIC_API_RATE=30          # requests per minute, per key
MUSIC_API_CORS=true        # allow browsers on other origins to call /v1

# ─── Runtime ───────────────────────────────────────────────────────────────
PORT=8080                   # health server (Render/Koyeb need this)
LOG_LEVEL=INFO
SESSION_NAME=vyron
