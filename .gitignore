# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state — never committed
.env
data/
data_test/
downloads/
*.session
journal.jsonl

# Node / frontend — `webapp/dist` is committed on purpose (it is what the
# server serves), but the build's own state is not.
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo
